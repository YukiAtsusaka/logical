Package: logical
Type: Package
Title: Predictions from a Logical Model of Minority Representation
Version: 0.1.0
Authors@R: c(
    person("Yuki", "Atsusaka",
           email = "atsusaka@uh.edu",
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-5365-1876")),
    person("Kolbe A.", "Dumas",
           email = "kdumas@uh.edu",
